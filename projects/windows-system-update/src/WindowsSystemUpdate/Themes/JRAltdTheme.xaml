<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:conv="clr-namespace:WindowsSystemUpdate.Converters">

    <!--
        Declared here (not in MainWindow.xaml) because UpdateCardTemplate below --
        which binds through these converters -- also lives in this dictionary.
        StaticResource resolves against the scope a XAML file was parsed in, not
        wherever a DataTemplate ends up applied at runtime, so the converters have to
        be visible from this file directly.
    -->
    <conv:UpdateStatusToTextConverter x:Key="StatusToTextConverter" />
    <conv:UpdateStatusToBrushConverter x:Key="StatusToBrushConverter" />
    <!-- Palette lifted from jraltdinc.us's :root custom properties, so the app reads
         as part of the same site/brand. -->
    <Color x:Key="BackgroundColor">#0A0E17</Color>
    <Color x:Key="BackgroundAltColor">#10151F</Color>
    <Color x:Key="CyanColor">#2FD8EF</Color>
    <Color x:Key="TextColor">#E6F1F5</Color>
    <Color x:Key="MutedColor">#9DB0BB</Color>
    <Color x:Key="ButtonTextColor">#06131A</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundAltBrush" Color="{StaticResource BackgroundAltColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="{StaticResource ButtonTextColor}" />
    <SolidColorBrush x:Key="CyanBorderBrush" Color="{StaticResource CyanColor}" Opacity="0.3" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#182330" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#16212B" />

    <!--
        Background/Foreground/FontFamily only. WindowStyle, ResizeMode, and the
        WindowChrome attached property are deliberately NOT set here: Window reads
        those at HWND-creation time (OnSourceInitialized), which happens before a
        Style-provided value has a chance to apply. Setting them via this implicit
        Style left the native OS title bar in place (tinted by the user's Windows
        accent color) with the custom title bar rendering as ordinary content
        underneath it -- a visible double title bar. Each Window must set
        WindowStyle="None" + WindowChrome.WindowChrome as local values directly on
        its own <Window> tag (see MainWindow.xaml) instead.
    -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- Flat title bar buttons (⚊ minimize / ✕ close), replacing the OS-drawn ones
         that WindowStyle="None" removes. -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TitleBarHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C42B2B" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Matches the site's .btn class: solid cyan, dark text, bold, rounded. -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CyanBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ButtonTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The update list is a vertical stack of cards (ListBox + this ItemContainerStyle
         + UpdateCardTemplate below), not a data-grid/table -- a plain row/column table
         is what reads as "basic Windows app" regardless of color. Each card mirrors the
         site's .card class: bg-alt fill, 1px 30%-opacity cyan border that brightens to
         full cyan on hover, 10px rounded corners. -->
    <Style x:Key="UpdateCardItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card"
                            Background="{StaticResource BackgroundAltBrush}"
                            BorderBrush="{StaticResource CyanBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ElevationBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <!-- Status pill background is the darker (non-alt) background so it stands out
         against the card's alt-background fill, rather than blending into it. -->
    <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource ElevationBadge}">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    </Style>

    <DataTemplate x:Key="UpdateCardTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0">
                    <Run Text="{Binding Id, Mode=OneWay}" />
                    <Run Text="  •  " />
                    <Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                    <Run Text=" → " />
                    <Run Text="{Binding AvailableVersion, Mode=OneWay}" Foreground="{StaticResource CyanBrush}" />
                    <Run Text="  •  " />
                    <Run Text="{Binding Source, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Center" ToolTip="{Binding StatusDetail}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                             Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
                               Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Thin flat scrollbar (no arrow buttons, no 3D track) instead of the default
         Windows gray/beveled scrollbar. Vertical-oriented; this app's list only ever
         needs vertical scrolling. -->
    <Style x:Key="FlatScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource CyanBorderBrush}" CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource FlatScrollBarThumb}" Width="6" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
