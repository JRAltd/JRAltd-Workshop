<Window x:Class="JRAltdIncProgramUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="JRAltd Inc Program Updater" Height="640" Width="960"
        MinHeight="480" MinWidth="760"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}">
    <!--
        Set directly on this Window, not via the shared Style in JRAltdTheme.xaml:
        WindowStyle/WindowChrome have to be local values before the HWND is created,
        or the native OS title bar stays and this custom one just renders underneath
        it. CaptionHeight below must match the title bar Grid's Height. GlassFrameThickness
        must stay a flat 0: a non-zero value (tried as a "keep the native drop shadow"
        trick) tells DWM to composite that region as glass, and without real glass
        compositing on modern Windows it just paints flat white over the whole client
        area instead of the Window's actual Background.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" />
    </shell:WindowChrome.WindowChrome>

    <!-- Explicit Background here (not left to the Window's own Background, even though
         JRAltdTheme.xaml's implicit Window Style sets one) because the gaps between
         cards and the margins around them were showing through as white: whatever is
         behind this Border wasn't reliably painting dark on its own. -->
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource CyanBorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar, replacing the OS-drawn one. -->
            <Grid Grid.Row="0" Height="40" Background="{StaticResource BackgroundAltBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" Foreground="{StaticResource CyanBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="JRAltd Inc Program Updater" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Content="&#x2013;" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button x:Name="CloseButton" Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click" ToolTip="Close" />
                </StackPanel>

                <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Background="{StaticResource CyanBorderBrush}" />
            </Grid>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                    <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource ElevationBadge}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ElevationBadge" Foreground="{StaticResource CyanBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="1"
                            Text="Powered by WinGet. Checks for and applies package updates from this machine's configured WinGet sources."
                            Style="{StaticResource MutedText}"
                            Margin="0,8,0,16" />

                <!-- A vertical stack of cards (see UpdateCardItem / UpdateCardTemplate in
                     JRAltdTheme.xaml), matching the site's .cards grid, instead of a
                     GridView data table. -->
                <ListBox Grid.Row="2" x:Name="UpdatesList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Extended"
                         ScrollViewer.CanContentScroll="False"
                         ItemContainerStyle="{StaticResource UpdateCardItem}"
                         ItemTemplate="{StaticResource UpdateCardTemplate}" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button x:Name="CheckForUpdatesButton" Content="Check for Updates" Style="{StaticResource AccentButton}" Click="CheckForUpdates_Click" Margin="0,0,8,0" />
                    <Button x:Name="UpdateSelectedButton" Content="Update Selected" Style="{StaticResource AccentButton}" Click="UpdateSelected_Click" Margin="0,0,8,0" />
                    <Button x:Name="UpdateAllButton" Content="Update All" Style="{StaticResource AccentButton}" Click="UpdateAll_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
