<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JRAltdIncProgramUpdater</RootNamespace>
    <AssemblyName>JRAltdIncProgramUpdater</AssemblyName>

    <!--
      requireAdministrator lives in app.manifest. WinGet upgrades routinely need to
      write to Program Files and HKLM, so the app is elevated from launch rather than
      prompting per-package mid-batch. See Services/ElevationHelper.cs for the runtime
      fallback and App.xaml.cs for the startup check.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Source SVG + regeneration steps: packaging/icon/. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!--
      Read at runtime by Services/AppUpdateService.cs (via
      Assembly.GetExecutingAssembly().GetName().Version) to compare against the
      latest GitHub release and decide whether to offer a self-update. Three places
      must be bumped together for every release, or the self-update check either
      won't fire or will loop offering an "update" to the version you're already on:
      this <Version>, packaging/setup.iss's MyAppVersion, and the git tag used for
      the GitHub release (program-updater-vX.Y.Z).
    -->
    <Version>1.1.2</Version>
  </PropertyGroup>

</Project>
